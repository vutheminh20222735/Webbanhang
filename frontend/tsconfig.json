{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "module": "es2020",
    "moduleResolution": "bundler", // 🌟 SỬA THÀNH BUNDLER (Chuẩn cho Angular mới)
    "importHelpers": true,
    "target": "ES2022",            // 🌟 NÂNG LÊN ES2022 để khớp cấu hình Angular CLI
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "useDefineForClassFields": false,
    "lib": ["es2020", "dom"],
    "rootDir": "./src"             // 🌟 GIỮ NGUYÊN để không bị lỗi cấu hình thư mục gốc
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": false,
    "strictInputAccessModifiers": false,
    "strictTemplates": false
  }
}
