PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/phone-shop?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:4200
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o
AI_RATE_LIMIT=20

# Production (Render):
# NODE_ENV=production
# CLIENT_URL=https://your-site.netlify.app
# MONGODB_URI must include a database name, e.g. ...mongodb.net/phone-shop?...
